body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.container {
    background-color: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px;
    width: 100%;
    max-width: 400px;
}

.profile-image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin-bottom: 20px;
}

#nameInput {
    border: 1px solid #000;
    width: 80%;
    padding: 10px;
    margin-bottom: 15px;
    box-sizing: border-box;
}

p {
    font-size: 16px;
    margin: 5px 0;
    color: #000;
}

.button-container {
    margin-top: 15px;
    width: 60%;
    display: flex;
    flex-direction: column;
}

button {
    background-color: #007AFF;
    color: white;
    border: none;
    padding: 10px;
    margin: 4px 0;
    font-size: 16px;
    cursor: pointer;
    border-radius: 4px;
}

button:hover {
    background-color: #0063cc;
}

button:active {
    background-color: #0056b3;
}
