<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS126-1L-Activity-1-Alconcel-Exam</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <img src="https://picsum.photos/150" alt="Profile Picture" class="profile-image">

        <input type="text" id="nameInput" placeholder="Enter your name">

        <p id="greetingMessage">Please enter your name</p>
        <p id="counterMessage">Tap the + button to start</p>

        <div class="button-container">
            <button id="incrementBtn">+</button>
            <button id="decrementBtn">-</button>
            <button id="resetBtn">RESET</button>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
